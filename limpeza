    <!-- JAVASCRIPT LOGIC -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // --- 1. MOBILE MENU TOGGLE ---
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            const menuIcon = document.getElementById('menuIcon');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
                if (mobileMenu.classList.contains('hidden')) {
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                } else {
                    menuIcon.classList.remove('fa-bars');
                    menuIcon.classList.add('fa-xmark');
                }
            });

            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    menuIcon.classList.remove('fa-xmark');
                    menuIcon.classList.add('fa-bars');
                });
            });

            // --- 2. BEFORE/AFTER SLIDER INTERACTIVITY ---
            const baSlider = document.getElementById('baSlider');
            const baBeforeImage = document.getElementById('baBeforeImage');
            const baHandle = document.getElementById('baHandle');
            let isDragging = false;

            function updateSliderPosition(x) {
                const rect = baSlider.getBoundingClientRect();
                let positionX = x - rect.left;
                
                if (positionX < 0) positionX = 0;
                if (positionX > rect.width) positionX = rect.width;

                const percentage = (positionX / rect.width) * 100;
                baBeforeImage.style.width = `${percentage}%`;
                baHandle.style.left = `${percentage}%`;
            }

            // Mouse Events
            baSlider.addEventListener('mousedown', (e) => {
                isDragging = true;
                updateSliderPosition(e.clientX);
            });

            window.addEventListener('mouseup', () => {
                isDragging = false;
            });

            window.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                updateSliderPosition(e.clientX);
            });

            // Touch Events for Mobile
            baSlider.addEventListener('touchstart', (e) => {
                isDragging = true;
                updateSliderPosition(e.touches[0].clientX);
            });

            window.addEventListener('touchend', () => {
                isDragging = false;
            });

            window.addEventListener('touchmove', (e) => {
                if (!isDragging) return;
                updateSliderPosition(e.touches[0].clientX);
            });


            // --- 3. INTERACTIVE CALCULATOR LOGIC ---
            const itemBtns = document.querySelectorAll('#itemSelector .calc-btn');
            const chkImpermeabilizacao = document.getElementById('chkImpermeabilizacao');
            const chkOdorPet = document.getElementById('chkOdorPet');
            const regiaoSelect = document.getElementById('regiaoSelect');

            // Summary elements
            const summaryItemName = document.getElementById('summaryItemName');
            const summaryBasePrice = document.getElementById('summaryBasePrice');
            const summaryExtrasPrice = document.getElementById('summaryExtrasPrice');
            const summaryFee = document.getElementById('summaryFee');
            const totalPriceEl = document.getElementById('totalPrice');

            let selectedItem = {
                name: 'Sofá 2 Lugares',
                price: 180
            };

            // Switch Selected Item Button
            itemBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    itemBtns.forEach(b => {
                        b.classList.remove('active', 'border-brand-500', 'bg-brand-500/20');
                        b.classList.add('border-slate-700', 'bg-slate-900/50');
                        const icon = b.querySelector('i');
                        if (icon) icon.className = icon.className.replace('text-brand-400', 'text-slate-400');
                    });

                    btn.classList.add('active', 'border-brand-500', 'bg-brand-500/20');
                    btn.classList.remove('border-slate-700', 'bg-slate-900/50');
                    const icon = btn.querySelector('i');
                    if (icon) icon.className = icon.className.replace('text-slate-400', 'text-brand-400');

                    selectedItem.name = btn.getAttribute('data-name');
                    selectedItem.price = parseFloat(btn.getAttribute('data-price'));

                    calculateTotal();
                });
            });

            // Handle Checkboxes & Select changes
            chkImpermeabilizacao.addEventListener('change', calculateTotal);
            chkOdorPet.addEventListener('change', calculateTotal);
            regiaoSelect.addEventListener('change', calculateTotal);

            function calculateTotal() {
                let basePrice = selectedItem.price;
                let extrasTotal = 0;

                if (chkImpermeabilizacao.checked) {
                    extrasTotal += parseFloat(chkImpermeabilizacao.value);
                }
                if (chkOdorPet.checked) {
                    extrasTotal += parseFloat(chkOdorPet.value);
                }

                let fee = parseFloat(regiaoSelect.value);
                let grandTotal = basePrice + extrasTotal + fee;

                // Update UI text
                summaryItemName.textContent = selectedItem.name;
                summaryBasePrice.textContent = `R$ ${basePrice.toFixed(2).replace('.', ',')}`;
                summaryExtrasPrice.textContent = `R$ ${extrasTotal.toFixed(2).replace('.', ',')}`;
                summaryFee.textContent = `R$ ${fee.toFixed(2).replace('.', ',')}`;
                totalPriceEl.textContent = `R$ ${grandTotal.toFixed(2).replace('.', ',')}`;
            }

            // --- 4. SEND ORÇAMENTO VIA WHATSAPP ---
            const btnSendWhatsapp = document.getElementById('btnSendWhatsapp');
            const custName = document.getElementById('custName');
            const custAddress = document.getElementById('custAddress');

            btnSendWhatsapp.addEventListener('click', () => {
                const name = custName.value.trim() || 'Cliente';
                const address = custAddress.value.trim() || 'Não informado';

                let extrasList = [];
                if (chkImpermeabilizacao.checked) extrasList.push('Impermeabilização Têxtil');
                if (chkOdorPet.checked) extrasList.push('Tratamento Odor/Urina Pet');
                const extrasText = extrasList.length > 0 ? extrasList.join(', ') : 'Nenhum';

                const totalStr = totalPriceEl.textContent;

                // Format WhatsApp Message
                const message = `Olá! Gostaria de agendar uma higienização.\n\n` +
                    `*-- RESUMO DO ORÇAMENTO --*\n` +
                    `👤 *Nome:* ${name}\n` +
                    `📍 *Bairro/Cidade:* ${address}\n` +
                    `🛋️ *Item:* ${selectedItem.name}\n` +
                    `✨ *Opcionais:* ${extrasText}\n` +
                    `💰 *Valor Estimado:* ${totalStr}\n\n` +
                    `Poderia confirmar a disponibilidade de data para atendimento?`;

                // Phone number format (replace with your business number)
                const phoneNumber = "5511999998888"; 
                const encodedMsg = encodeURIComponent(message);
                const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMsg}`;

                window.open(whatsappUrl, '_blank');
            });

            // Initial calculation call
            calculateTotal();
        });
    </script>
</body>
</html>
