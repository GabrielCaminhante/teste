    <style>
        /* Estilos personalizados para o Slider de Comparação Antes/Depois */
        .ba-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            border-radius: 1rem;
            user-select: none;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        .ba-image-before {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 50%;
            overflow: hidden;
            z-index: 10;
            border-right: 3px solid #14b8a6;
        }
        .ba-image-before img, .ba-image-after img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            pointer-events: none;
        }
        .ba-slider-handle {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #14b8a6;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 15px rgba(0,0,0,0.3);
            z-index: 20;
            cursor: ew-resize;
            border: 3px solid white;
        }
        
        /* Glassmorphism custom effects */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .glass-dark {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Custom Scrollbar */
