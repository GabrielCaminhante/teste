                <!-- Horários -->
                <div>
                    <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Atendimento</h4>
                    <ul class="space-y-2 text-sm">
                        <li>Segunda a Sexta: 08:00 - 18:00</li>
                        <li>Sábado: 08:00 - 14:00</li>
                        <li>Atendimento com hora marcada</li>
                        <li class="text-brand-400 font-semibold pt-2">Atendemos em Domicílio</li>
                    </ul>
                </div>

                <!-- Contato Direct -->
                <div>
                    <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Contato Direto</h4>
                    <ul class="space-y-3 text-sm">
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-phone text-brand-500"></i>
                            <span>(11) 99999-8888</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-envelope text-brand-500"></i>
                            <span>contato@aquacleanestofados.com.br</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-location-dot text-brand-500"></i>
                            <span>São Paulo & Região Metropolitana</span>
                        </li>
                    </ul>
